# RelayCore Environment Configuration
PROJECT_NAME="RelayCore Webhook & Event Delivery Engine"
VERSION="1.0.0"

# Database & Redis Connections
POSTGRES_USER=relaycore
POSTGRES_PASSWORD=relaycore_pass
POSTGRES_DB=relaycore_db
DATABASE_URL=postgresql+asyncpg://relaycore:relaycore_pass@postgres:5432/relaycore_db
SQLITE_FALLBACK_PATH=relaycore_runtime.db
REDIS_URL=redis://redis:6379/0

# Worker Concurrency & Polling
WORKER_CONCURRENCY=4
WORKER_BATCH_SIZE=25
WORKER_POLL_INTERVAL_SEC=0.5
WORKER_HTTP_TIMEOUT_SEC=5.0

# Exponential Backoff & Jitter
DEFAULT_MAX_RETRIES=5
BACKOFF_BASE_SECONDS=2.0
BACKOFF_MAX_SECONDS=300.0
BACKOFF_JITTER_RATIO=0.25

# 3-State Circuit Breaker
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT_SEC=30.0
CB_HALF_OPEN_MAX_CALLS=2

# Per-Tenant Token Bucket Rate Limiter
RL_DEFAULT_CAPACITY=20
RL_DEFAULT_REFILL_RATE_PER_SEC=10.0

# Cryptographic Webhook Signing
SIGNATURE_TOLERANCE_SECONDS=300
